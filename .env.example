# ============================================================
#  模型（DeepSeek，OpenAI 兼容）
# ============================================================
# 你的 DeepSeek API Key（不要提交到 git）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# deepseek-chat（通用）或 deepseek-reasoner（推理）
OPENAI_MODEL=deepseek-chat

# ============================================================
#  本地语料库
# ============================================================
POLICY_CORPUS_DB=data/corpus.db
POLICY_DOCS_DIR=data/docs

# ============================================================
#  智能体标识
# ============================================================
POLICY_AGENT_ID=official-policy-execution-partner
POLICY_AGENT_DISPLAY_NAME=官方政策执行解读智能体
POLICY_AGENT_VERSION=0.1.0
POLICY_ORGANIZATION=
POLICY_COUNTRY_CODE=CN

# ============================================================
#  ACPs 接入（梧桐 / wt.ioa.pub）
# ============================================================
# 平台账号（wit 通过 RegistryPasswordCredentials.from_env() 读取）
ACPS_USERNAME=
ACPS_PASSWORD=
# 平台 profile：
#   wt  = 2026AIC 大赛平台（wt.ioa.pub）—— 默认，参赛请用这个
#   ioa = wit 内置的 ioa.pub（www.ioa.pub）
#         ⚠️ 这与大赛平台【不是】同一个部署，账号不通用；填错会报 401 USER_NOT_FOUND
#   custom = 完全由下面的 ACPS_* 地址决定
ACPS_PROFILE=wt

# 指向其它环境时才需要取消注释（会覆盖 profile 的默认地址）
#ACPS_REGISTRY_URL=https://wt.ioa.pub/registry-server
#ACPS_REGISTRY_MTLS_URL=
#ACPS_CA_URL=https://wt.ioa.pub/ca-server
#ACPS_DISCOVERY_URL=https://wt.ioa.pub/discovery/acps-adp-v2/discover

# ------------------------------------------------------------
#  ★ POLICY_PUBLIC_ENDPOINT —— 平台用来"找到并调用你"的对外地址
#    可以理解为：你的智能体在互联网上的门牌号。
#    三条硬性要求：
#      1) 必须 https:// 开头
#      2) 必须能被平台（wt.ioa.pub）访问到
#      3) 结尾必须是 /acps/aip/v1
#
#    按你的情况填其中一种：
#      · 有公网域名        : https://agent.example.com/acps/aip/v1
#      · 有云服务器公网 IP : https://203.0.113.10/acps/aip/v1
#      · 用内网穿透(隧道)  : https://<隧道分配的主机名>/acps/aip/v1
#      · 平台/单位给的机器 : https://<赛方给你的主机名>/acps/aip/v1
# ------------------------------------------------------------
POLICY_PUBLIC_ENDPOINT=

# ★ POLICY_CERT_DNS —— 上面地址的"主机名部分"，写进 mTLS 证书 SAN
#    通常【留空】即可：程序会自动取 POLICY_PUBLIC_ENDPOINT 的主机名。
#    只有当你想用其它主机名接入时才手动填（多个用英文逗号分隔）。
#    若地址是 IP，会自动写成证书的 IP SAN，无需你操心。
#    注意：填的必须是纯主机名，不要带 https:// 和路径。
#      对 : https://agent.example.com/acps/aip/v1  ->  agent.example.com
POLICY_CERT_DNS=

# listener 在本机的监听地址/端口（一般不用改）
POLICY_BIND_HOST=0.0.0.0
POLICY_BIND_PORT=8443
POLICY_CERT_VALIDITY_DAYS=365

# ============================================================
#  运行态目录（已被 .gitignore 忽略）
# ============================================================
POLICY_WORKSPACE=.wit
