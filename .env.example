# ===== 模型（DeepSeek，OpenAI 兼容）=====
# 你的 DeepSeek API Key（不要提交到 git）
OPENAI_API_KEY=
# DeepSeek 的 OpenAI 兼容地址
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名：deepseek-chat（通用）或 deepseek-reasoner（推理）
OPENAI_MODEL=deepseek-chat

# ===== 本地语料库 =====
# 语料库 SQLite 路径（默认 data/corpus.db，已被 .gitignore 忽略）
POLICY_CORPUS_DB=data/corpus.db
# 批量导入目录（可选）
POLICY_DOCS_DIR=data/docs

# ===== 智能体标识 =====
POLICY_AGENT_ID=official-policy-execution-partner
POLICY_AGENT_DISPLAY_NAME=官方政策执行解读智能体
POLICY_AGENT_VERSION=0.1.0
POLICY_ORGANIZATION=
POLICY_COUNTRY_CODE=CN

# ===== ACPs 接入（梧桐 / wt.ioa.pub）=====
# 平台账号（wit 通过 RegistryPasswordCredentials.from_env() 读取）
ACPS_USERNAME=
ACPS_PASSWORD=
# 默认走 ioa.pub 固定基础设施；非 ioa 环境时改为 custom 并填 ACPS_* 地址
ACPS_PROFILE=ioa

# 对外公开端点：必须是平台可达的 HTTPS 地址，且证书 SAN 覆盖其主机名。
# 本地/内网联调时可用反向代理、NAT 或 host.docker.internal 暴露端口。
POLICY_PUBLIC_ENDPOINT=
# listener 实际绑定的本地地址/端口
POLICY_BIND_HOST=0.0.0.0
POLICY_BIND_PORT=8443
# 证书 DNS SAN（留空则从 POLICY_PUBLIC_ENDPOINT 的主机名推导）
POLICY_CERT_DNS=
POLICY_CERT_VALIDITY_DAYS=365

# ===== 运行态目录（已被 .gitignore 忽略）=====
POLICY_WORKSPACE=.wit
